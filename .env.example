# Neon (PostgreSQL) connection string
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Use a long random string (32+ characters), e.g. `openssl rand -hex 32`
JWT_SECRET=

# Origin(s) of the client app, used for CORS. Comma-separate several, no trailing slash.
# Production example: https://aatmabal.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Upstash Redis (Upstash console -> your database -> REST API section).
# Optional: leave empty to run without a cache. On Vercel, the Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which are also understood.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# PORT=4000
# DB_POOL_MAX=3

# Bill Book (future module)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
